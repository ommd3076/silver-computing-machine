# DebugLeaf Driver Mobile Integration - Runtime Environment Configuration

# Authentication Mode ('token' or 'local'). 'token' is required for driver vs dispatcher separation.
DEBUGLEAF_AUTH_MODE=token

# Server-Side Pre-Configured Role Bearer Tokens (never commit production secrets)
DEBUGLEAF_DISPATCHER_TOKEN=DEBUGLEAF_DISPATCHER_SECRET_KEY_9988
DEBUGLEAF_ADMIN_TOKEN=DEBUGLEAF_ADMIN_SECRET_KEY_7766
DEBUGLEAF_RESEARCHER_TOKEN=DEBUGLEAF_RESEARCHER_SECRET_KEY_5544

# Isolated Demo SQLite Database Path
DEBUGLEAF_DEMO_DB_PATH=.runtime/demo_store.sqlite3

# Demo Fixture Mode ('1' seeds deterministic test codes PAIR01 and PAIR02)
DEBUGLEAF_DEMO_FIXTURE_MODE=1

# Server Bind Address & Port
DEBUGLEAF_HOST=0.0.0.0
DEBUGLEAF_PORT=8000

# Mobile Client API Base URL (point to Lenovo Legion private IPv4)
EXPO_PUBLIC_API_URL=http://172.80.1.249:8000/api/v1/demo
